# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional public backend URL used by Android APK builds to reach /api/billing/*
VITE_API_BASE_URL=""

# VITE_GITHUB_REPO: Public GitHub repository (owner/repo) for APK release update checks (auto-set in GitHub Actions)
VITE_GITHUB_REPO=""

# SSLCommerz (Bangladesh Debit Cards, bKash, Nagad, Rocket, NetBanking)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWD=""
SSLCOMMERZ_IS_LIVE="false"

# Binance Pay (USDT Crypto Wallet / Cardless Checkout)
BINANCE_PAY_API_KEY=""
BINANCE_PAY_SECRET_KEY=""

# Server HMAC secret for signing verified purchase receipts
BILLING_SIGNING_SECRET=""

# Support Email Reply (SMTP - e.g. Gmail App Password for riyadislambdd@gmail.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="riyadislambdd@gmail.com"
SMTP_PASS=""
SMTP_FROM=""

# Gemini API key for server-side AI Vision OCR (/api/ocr)
GEMINI_API_KEY=
